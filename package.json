{
  "name": "superdsp",
  "private": true,
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "prepare": "simple-git-hooks",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "turbo format"
  },
  "devDependencies": {
    "@superdsp/eslint-config": "workspace:*",
    "eslint": "catalog:",
    "lint-staged": "^16.4.0",
    "prettier": "catalog:",
    "simple-git-hooks": "^2.13.1",
    "turbo": "^2.9.7",
    "typescript": "catalog:"
  },
  "volta": {
    "node": "24.15.0",
    "pnpm": "10.33.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "prisma"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  }
}

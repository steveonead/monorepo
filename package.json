{
  "name": "superdsp",
  "private": true,
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "prepare": "simple-git-hooks",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:mockoon": "turbo run dev:mockoon",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "prisma:generate": "pnpm --filter @superdsp/backend prisma:generate",
    "prisma:migrate": "pnpm --filter @superdsp/backend prisma:migrate",
    "prisma:studio": "pnpm --filter @superdsp/backend prisma:studio"
  },
  "devDependencies": {
    "@superdsp/eslint-config": "workspace:*",
    "@total-typescript/ts-reset": "^0.6.1",
    "eslint": "catalog:",
    "lint-staged": "^16.4.0",
    "prettier": "catalog:",
    "simple-git-hooks": "^2.13.1",
    "turbo": "^2.9.12",
    "typescript": "catalog:"
  },
  "volta": {
    "node": "24.15.0",
    "pnpm": "11.1.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  }
}

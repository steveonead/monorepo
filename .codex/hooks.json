{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/block-dangerous.sh\"",
            "statusMessage": "檢查危險指令"
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/enforce-pnpm.sh\"",
            "statusMessage": "強制使用 pnpm"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/lint-and-format.sh\"",
            "statusMessage": "ESLint --fix + Prettier"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/typecheck.sh\"",
            "timeout": 120,
            "statusMessage": "Typecheck（pnpm turbo typecheck）"
          }
        ]
      }
    ]
  }
}

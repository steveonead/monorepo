{
  "name": "@superdsp/api-schemas",
  "version": "0.0.1",
  "private": true,
  "exports": {
    "./auth/*": {
      "import": {
        "types": "./dist/auth/*.d.mts",
        "default": "./dist/auth/*.mjs"
      },
      "require": {
        "types": "./dist/auth/*.d.cts",
        "default": "./dist/auth/*.cjs"
      }
    },
    "./base/*": {
      "import": {
        "types": "./dist/base/*.d.mts",
        "default": "./dist/base/*.mjs"
      },
      "require": {
        "types": "./dist/base/*.d.cts",
        "default": "./dist/base/*.cjs"
      }
    },
    "./campaigns/*": {
      "import": {
        "types": "./dist/campaigns/*.d.mts",
        "default": "./dist/campaigns/*.mjs"
      },
      "require": {
        "types": "./dist/campaigns/*.d.cts",
        "default": "./dist/campaigns/*.cjs"
      }
    }
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@superdsp/eslint-config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.21.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "name": "@superdsp/api-schemas",
  "version": "0.0.1",
  "private": true,
  "exports": {
    "./auth/*": {
      "types": "./src/auth/*.ts",
      "default": "./src/auth/*.ts"
    },
    "./base/*": {
      "types": "./src/base/*.ts",
      "default": "./src/base/*.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@superdsp/eslint-config": "workspace:*",
    "typescript": "catalog:"
  }
}

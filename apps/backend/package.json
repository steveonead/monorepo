    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/swagger": "^11.4.4",
    "@prisma/client": "^6.19.3",
    "@superdsp/api-schemas": "workspace:*",
    "axios": "catalog:",
    "date-fns": "catalog:",
    "es-toolkit": "catalog:",

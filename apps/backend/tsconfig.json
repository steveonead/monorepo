{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": ["node"],
    "noUncheckedIndexedAccess": false,
    "declaration": true,
    "outDir": "./dist",
    "removeComments": true,
    "sourceMap": true
  },
  "include": ["src/**/*", "test/**/*", "prisma.config.ts", "vitest.config.ts"]
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "baseUrl": ".",
    "module": "Node16",
    "moduleResolution": "Node16",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node", "vitest/globals"],
    "declaration": true,
    "outDir": "./dist",
    "removeComments": true,
    "sourceMap": true
  },
  "include": ["src/**/*", "test/**/*", "prisma.config.ts", "vitest.config.mts"]
}
